# Sample inputs for a local `terraform plan`. Copy this file to
# terraform.tfvars and fill in real values. Do not commit that copy.
# GitHub Actions does not read this file. It passes the same settings
# from the selected client's GitHub Environment (TF_VAR_* variables).
subscription_id      = "00000000-0000-0000-0000-000000000000"
location             = "eastus"
client_code          = "acme"
react_webapp_name    = "acme-react-prod-001"
fastapi_webapp_name  = "acme-api-prod-001"
app_service_sku_name = "B1"
